{
  "info": {
    "_postman_id": "e6ab5de8-f190-4bf4-8051-3ca96a3038ef",
    "name": "OAuth-Flickr",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1-Fetch the Temporary Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"OAuth response status is 200\", () => pm.response.to.have.status(200));",
              "const params = require(\"postman-collection\").QueryParam.parse(pm.response.text());",
              "const token = params.find(p => p.key === \"oauth_token\");",
              "const secret = params.find(p => p.key === \"oauth_token_secret\");",
              "pm.test(\"OAuth token and secret are present\", () => {",
              "    pm.expect(token && token.value).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(secret && secret.value).to.be.a(\"string\").and.not.empty;",
              "});",
              "if (token && secret) {",
              "    pm.environment.set(\"oAuth_Temp_Token\", token.value);",
              "    pm.environment.set(\"oAuth_Temp_Token_Secret\", secret.value);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "oauth1",
          "oauth1": [
            {
              "key": "callback",
              "value": "{{callbackUrl}}",
              "type": "string"
            },
            {
              "key": "consumerKey",
              "value": "{{consumerKey}}",
              "type": "string"
            },
            {
              "key": "consumerSecret",
              "value": "{{consumerSecret}}",
              "type": "string"
            },
            {
              "key": "signatureMethod",
              "value": "HMAC-SHA1",
              "type": "string"
            },
            {
              "key": "version",
              "value": "1.0",
              "type": "string"
            },
            {
              "key": "addParamsToHeader",
              "value": false,
              "type": "boolean"
            },
            {
              "key": "addEmptyParamsToSign",
              "value": false,
              "type": "boolean"
            }
          ]
        },
