    },
    {
      "name": "2-Create a Booking",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw);",
              "pm.request.body.update(resolvedBody);",
              "pm.collectionVariables.set(\"lastRequestBody\", resolvedBody);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "const postResponse=pm.response.json();",
              "",
              "const booking_Id=postResponse.bookingid;",
              "pm.collectionVariables.set(\"bookingId\", booking_Id);",
              "",
              "const postRequest=JSON.parse(pm.collectionVariables.get(\"lastRequestBody\"));",
              "const first_Name=postRequest.firstname;",
              "pm.collectionVariables.set(\"firstName\", first_Name);",
              "",
              "const last_Name=postRequest.lastname;",
              "pm.collectionVariables.set(\"lastName\", last_Name);",
              "",
              "const total_Price=postRequest.totalprice;",
              "pm.collectionVariables.set(\"totalPrice\", total_Price);",
              "",
              "",
              "const deposit_Paid = postRequest.depositpaid;",
              "pm.collectionVariables.set(\"depositPaid\", deposit_Paid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\" : \"{{$randomFirstName}}\",\n    \"lastname\" : \"{{$randomLastName}}\",\n    \"totalprice\" : {{$randomInt}},\n    \"depositpaid\" : {{$randomBoolean}},\n    \"bookingdates\" : {\n        \"checkin\" : \"2030-01-01\",\n        \"checkout\" : \"2030-01-05\"\n    },\n    \"additionalneeds\" : \"{{$randomWord}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURI}}/booking",
          "host": [
            "{{BaseURI}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3-Fetching Already Created Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "pm.test(\"Compare POST request data with GET response\", function () {",
              "    const getResponse = pm.response.json();",
              "",
              "    pm.expect(getResponse.firstname).to.eql(pm.collectionVariables.get(\"firstName\"));",
              "    pm.expect(getResponse.lastname).to.eql(pm.collectionVariables.get(\"lastName\"));",
              "    pm.expect(getResponse.totalprice).to.eql(pm.collectionVariables.get(\"totalPrice\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
