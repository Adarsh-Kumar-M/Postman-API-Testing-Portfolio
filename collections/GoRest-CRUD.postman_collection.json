  "item": [
    {
      "name": "1-Post Request for Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw);",
              "pm.request.body.update(resolvedBody);",
              "pm.collectionVariables.set(\"lastRequestBody\", resolvedBody);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response=pm.response.json();",
              "",
              "const id=response.id;",
              "pm.collectionVariables.set(\"userId\", id);",
              "",
              "const email=response.email;",
              "",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "",
              "const requestBody=JSON.parse(pm.collectionVariables.get(\"lastRequestBody\"));",
              "const reqEmail=requestBody.email;",
              "const reqname=requestBody.name;",
              "",
              "",
              "pm.collectionVariables.set(\"reqName\", reqname);",
              "",
              "",
              "pm.collectionVariables.set(\"reqEmail\", requestBody.email);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{TokenId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{$randomFullName}}\",\n    \"email\": \"{{$randomEmail}}\",\n    \"gender\": \"male\",\n    \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURI}}/public/v2/users",
          "host": [
            "{{BaseURI}}"
          ],
          "path": [
            "public",
            "v2",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2-Fetching Created User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Comparing the post request Email and Name against GET response Email and Name\", function () {",
              "    const getResponce = pm.response.json();",
              "    pm.expect(getResponce.email).to.eql(pm.collectionVariables.get(\"reqEmail\"));",
              "    pm.expect(getResponce.name).to.eql(pm.collectionVariables.get(\"reqName\"));    ",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
