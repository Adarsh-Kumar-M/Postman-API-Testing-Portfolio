    {
      "name": "5-Update Contact Details (PUT)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw);",
