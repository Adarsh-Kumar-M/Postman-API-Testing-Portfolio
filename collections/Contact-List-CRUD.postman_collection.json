          "mode": "raw",
          "raw": "{\n    \"firstName\": \"{{$randomFirstName}}\",\n    \"lastName\": \"{{$randomLastName}}\",\n    \"city\": \"{{$randomCity}}\"\n \n}",
          "options": {
            "raw": {
              "language": "json"
