              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
              "        .to.include(\"application/json\");",
              "});",
              "",
              "const putRequest=JSON.parse(pm.collectionVariables.get(\"lastRequestBody\"));",
              "const updatedFirstName=putRequest.firstName;",
              "pm.collectionVariables.set(\"updated_FirstName\", updatedFirstName);",
              "",
              "const updatedLastName=putRequest.lastName;",
              "pm.collectionVariables.set(\"updated_LastName\", updatedLastName);",
              "",
              "const updatedCity=putRequest.city;",
              "pm.collectionVariables.set(\"updated_City\", updatedCity);"
            ]
          }
        }
      ],
