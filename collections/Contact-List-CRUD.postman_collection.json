  "item": [
    {
      "name": "1-Login into Contact List App",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw);",
              "pm.request.body.update(resolvedBody);",
              "pm.collectionVariables.set(\"lastRequestBody\", resolvedBody);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "    });",
              "",
              "pm.test(\"Body matches string\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"adarshkumar34421@gmail.com\");",
              "});",
              "",
              "pm.test(\"First name should be Adarsh Kumar\", function () {",
              "    const firstName = pm.response.json();",
              "    pm.expect(firstName.user.firstName).to.eql(\"Adarsh Kumar\");",
              "});",
              "",
              "const postResponse=pm.response.json();",
              "",
              "const token_Id=postResponse.token;",
              "pm.collectionVariables.set(\"tokenId\", token_Id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"adarshkumar34421@gmail.com\",\n    \"password\": \"adarsh@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURI}}/users/login",
          "host": [
            "{{BaseURI}}"
          ],
          "path": [
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2-Create a Fresh Contact",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw);",
              "pm.request.body.update(resolvedBody);",
              "pm.collectionVariables.set(\"lastRequestBody\", resolvedBody);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Content-Type is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
              "        .to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Status code name has string\", function () {",
              "    pm.response.to.have.status(\"Created\");",
              "});",
              "",
              "const postResponse=pm.response.json();",
              "",
              "const user_Id=postResponse._id;",
              "pm.collectionVariables.set(\"userId\", user_Id);",
              "",
              "const postRequestBody=JSON.parse(pm.collectionVariables.get(\"lastRequestBody\"));",
              "const firstName=postRequestBody.firstName;",
              "pm.collectionVariables.set(\"firstName\", firstName);",
              "",
              "const city=postRequestBody.city;",
              "pm.collectionVariables.set(\"city\", city);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstName\": \"{{$randomFirstName}}\",\n    \"lastName\": \"{{$randomLastName}}\",\n    \"birthdate\": \"2000-01-01\",\n    \"city\": \"{{$randomCity}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BaseURI}}/contacts",
          "host": [
            "{{BaseURI}}"
          ],
          "path": [
            "contacts"
          ]
        }
      },
      "response": []
    },
